# Banco de dados — PostgreSQL (mesmo servidor do projeto signa, database proprio)
DATABASE_URL="postgresql://usuario:senha@host:5432/seguros?sslmode=require"

# Aplicacao
PORT=3010
NODE_ENV=development
APP_URL=http://localhost:5173
API_PREFIX=api

# JWT
JWT_SECRET="troque-me"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="troque-me"
JWT_REFRESH_EXPIRES_IN=7d

# Reset de senha
PASSWORD_RESET_EXPIRES_MIN=60

# SMTP (preencher) — usado para convites e recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pinho Seguros <nao-responda@pinho.com.br>"

# Comunicação por processo (tarefa 31) — anexos ficam em disco, um diretório por processo
ATTACHMENTS_DIR=./storage/attachments

# Gmail OAuth — cada operador conecta a própria conta para enviar mensagens.
# Criar em https://console.cloud.google.com/apis/credentials: credencial "Aplicativo Web",
# escopo gmail.send, com GOOGLE_OAUTH_REDIRECT_URI cadastrado como URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3010/api/gmail/callback
