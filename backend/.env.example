# Sem aspas nos valores: o `docker run --env-file` em produção nao remove aspas,
# passa a linha literal (aspas inclusas) como valor da variavel.

# Banco de dados — PostgreSQL (mesmo servidor do projeto signa, database proprio)
DATABASE_URL=postgresql://usuario:senha@host:5432/seguros?sslmode=require


# Aplicacao
PORT=3010
NODE_ENV=development
APP_URL=http://localhost:5173
API_PREFIX=api

# JWT
JWT_SECRET=troque-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-me
JWT_REFRESH_EXPIRES_IN=7d

# Reset de senha
PASSWORD_RESET_EXPIRES_MIN=60

# SMTP (preencher) — usado para convites e recuperação de senha
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Pinho Seguros <nao-responda@pinho.com.br>

# Comunicação por processo (tarefa 31) — anexos ficam num bucket S3 dedicado,
# um prefixo por processo (usuário IAM com permissão restrita a este bucket,
# ver arn:aws:s3:::NOME-DO-BUCKET e arn:aws:s3:::NOME-DO-BUCKET/* na policy)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# Gmail OAuth — cada operador conecta a própria conta para enviar mensagens.
# Criar em https://console.cloud.google.com/apis/credentials: credencial "Aplicativo Web",
# escopo gmail.send, com GOOGLE_OAUTH_REDIRECT_URI cadastrado como URI de redirecionamento.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3010/api/gmail/callback

# SIGRA (sigraweb) — banco de terceiro (Infoline Systems), acesso SOMENTE LEITURA
# (ver CLAUDE.md § Trabalho no banco do SIGRA e docs/SIGRA_DB.md). TLS mútuo com
# certificados em backend/certs/sigra/. Sem essas variáveis, a integração fica desabilitada.
DB_SIGRA_HOST=
DB_SIGRA_PORT=5432
DB_SIGRA_USERNAME=
DB_SIGRA_PASSWORD=
DB_SIGRA_DATABASE=sigraweb
DB_SIGRA_SSL_CA=certs/sigra/server-ca.pem
DB_SIGRA_SSL_CERT=certs/sigra/client-cert.pem
DB_SIGRA_SSL_KEY=certs/sigra/client-key.pem
